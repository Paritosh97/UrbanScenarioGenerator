    <Story name="UserTaskStory">
      <Act name="UserTaskAct">
        <ManeuverGroup name="UserTaskGroup" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="User" />
          </Actors>
          <Maneuver name="UserTasks">
            <Event name="task_1_wait_then_cross" priority="override" maximumExecutionCount="1">
              <Action name="vr_task">
                <UserDefinedAction>
                  <CustomCommandAction type="VR_TASK">
                    <VRTask id="1" name="wait_then_cross" category="ptp_env" required="true">
                      <EventName>task_1_wait_then_cross</EventName>
                      <Goal>
                        <Type>go</Type>
                        <Target>wait_then_cross</Target>
                        <KeyItem>Location</KeyItem>
                      </Goal>
                      <Instructions>
                        <Text lang="en">Wait for green, then cross.</Text>
                      </Instructions>
                      <Feedback>
                        <Success lang="en">Well done!</Success>
                        <Failure lang="en">That did not work. Try again.</Failure>
                      </Feedback>
                      <Target>
                        <Position>
                          <WorldPosition x="12.002" y="4.250" z="0.000" h="0.0000" p="0" r="0" />
                        </Position>
                      </Target>
                      <Constraints>
                        <precedence>1</precedence>
                        <evaluation>spec</evaluation>
                        <MaxSpeed value="3" />
                        <Tolerance value="1.5" />
                        <StartTime value="0" />
                      </Constraints>
                      <FailureCondition>
                        <InitialTimeoutFailureCondition timeout="70" />
                        <BaselineTimeoutFailureCondition timeout="110" />
                      </FailureCondition>
                      <Spec origin="spec">
                        <Goal>
                          <F op="eventually" start="0">
                            <F op="and">
                              <F op="until" start="0">
                                <F op="in_zone">
                                  <Zone kind="disc" x="12.00210405" y="-4.25" r="3" />
                                </F>
                                <F op="signal_is" state="green" signal="signal_1" />
                              </F>
                              <F op="eventually" start="0">
                                <F op="eventually" start="0">
                                  <F op="in_zone">
                                    <Zone kind="disc" x="12.00210405" y="4.25" r="2" />
                                  </F>
                                </F>
                              </F>
                            </F>
                          </F>
                        </Goal>
                        <Safety>
                          <F op="always" label="crossed on red" start="0">
                            <F op="implies">
                              <F op="and">
                                <F op="in_zone">
                                  <Zone kind="rect" cx="12.00210405" cy="0" h="1.570796327" hl="3.25" hw="1.5" />
                                </F>
                                <F op="prev" init="true">
                                  <F op="not">
                                    <F op="in_zone">
                                      <Zone kind="rect" cx="12.00210405" cy="0" h="1.570796327" hl="3.25" hw="1.5" />
                                    </F>
                                  </F>
                                </F>
                              </F>
                              <F op="signal_is" state="green" signal="signal_1" />
                            </F>
                          </F>
                        </Safety>
                      </Spec>
                    </VRTask>
                  </CustomCommandAction>
                </UserDefinedAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="T1Time" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition value="0.0" rule="greaterOrEqual" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActStart" delay="0.0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition value="0.0" rule="greaterOrEqual" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
        <StopTrigger />
      </Act>
    </Story>
    <Story name="MoveStory_Car1">
