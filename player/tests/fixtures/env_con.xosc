    <Story name="UserTaskStory">
      <Act name="UserTaskAct">
        <ManeuverGroup name="UserTaskGroup" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="User" />
          </Actors>
          <Maneuver name="UserTasks">
            <Event name="task_1_cross_past_parked" priority="override" maximumExecutionCount="1">
              <Action name="vr_task">
                <UserDefinedAction>
                  <CustomCommandAction type="VR_TASK">
                    <VRTask id="1" name="cross_past_parked" category="env_constrained" required="true">
                      <EventName>task_1_cross_past_parked</EventName>
                      <Goal>
                        <Type>cross</Type>
                        <Target>crossing_3</Target>
                        <KeyItem>Crosswalk</KeyItem>
                      </Goal>
                      <Instructions>
                        <Text lang="en">Cross the road without touching the parked cars</Text>
                      </Instructions>
                      <Feedback>
                        <Success lang="en">You crossed safely.</Success>
                        <Failure lang="en">You bumped into a parked car.</Failure>
                      </Feedback>
                      <Target>
                        <Position>
                          <WorldPosition x="-70.000" y="4.250" z="0.000" h="-1.5708" p="0" r="0" />
                        </Position>
                        <UserData>
                          <Feature id="crossing_3" u="1" v="0" />
                        </UserData>
                      </Target>
                      <Constraints>
                        <precedence>1</precedence>
                        <evaluation>proximity</evaluation>
                        <MaxSpeed value="3" />
                        <Tolerance value="1.5" />
                        <StartTime value="0" />
                      </Constraints>
                      <FailureCondition>
                        <InitialTimeoutFailureCondition timeout="60" />
                        <BaselineTimeoutFailureCondition timeout="90" />
                        <CollisionFailureCondition>
                          <EntityRef entityRef="Car1" />
                          <EntityRef entityRef="Car2" />
                          <EntityRef entityRef="Car3" />
                          <EntityRef entityRef="Car4" />
                        </CollisionFailureCondition>
                      </FailureCondition>
                      <Spec origin="helper">
                        <Goal>
                          <F op="eventually" start="0">
                            <F op="in_zone">
                              <Zone kind="disc" x="-70" y="4.25" r="1.5" />
                            </F>
                          </F>
                        </Goal>
                        <Safety>
                          <F op="always" label="collision with Car1" start="0">
                            <F op="dist_ge" entity="Car1" d="0.3" />
                          </F>
                          <F op="always" label="collision with Car2" start="0">
                            <F op="dist_ge" entity="Car2" d="0.3" />
                          </F>
                          <F op="always" label="collision with Car3" start="0">
                            <F op="dist_ge" entity="Car3" d="0.3" />
                          </F>
                          <F op="always" label="collision with Car4" start="0">
                            <F op="dist_ge" entity="Car4" d="0.3" />
                          </F>
                        </Safety>
                      </Spec>
                    </VRTask>
                  </CustomCommandAction>
                </UserDefinedAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="T1Time" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition value="0.0" rule="greaterOrEqual" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActStart" delay="0.0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition value="0.0" rule="greaterOrEqual" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
        <StopTrigger />
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="StopCondition" delay="0.0" conditionEdge="rising">
          <ByValueCondition>
            <SimulationTimeCondition value="95.0" rule="greaterThan" />
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>