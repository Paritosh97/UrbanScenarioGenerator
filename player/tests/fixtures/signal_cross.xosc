  </RoadNetwork>
  <Entities>
    <ScenarioObject name="User">
      <Pedestrian name="User" pedestrianCategory="pedestrian" model3d="user_rig" mass="75.0">
        <BoundingBox>
          <Center x="0.0" y="0.0" z="0.875" />
          <Dimensions width="0.6" length="0.6" height="1.75" />
        </BoundingBox>
        <Properties>
          <Property name="usg_role" value="user" />
        </Properties>
      </Pedestrian>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <GlobalAction>
          <InfrastructureAction>
            <TrafficSignalAction>
              <TrafficSignalStateAction name="1" state="on;off" />
            </TrafficSignalAction>
          </InfrastructureAction>
        </GlobalAction>
        <Private entityRef="User">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <WorldPosition x="12.002" y="-5.25" z="0.0" h="1.5708" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time" />
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="0.0" />
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="UserTaskStory">
      <Act name="UserTaskAct">
        <ManeuverGroup name="UserTaskGroup" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="User" />
          </Actors>
          <Maneuver name="UserTasks">
            <Event name="task_1_cross_crossing_1" priority="override" maximumExecutionCount="1">
              <Action name="vr_task">
                <UserDefinedAction>
                  <CustomCommandAction type="VR_TASK">
                    <VRTask id="1" name="cross_crossing_1" category="ptp_env" required="true">
                      <EventName>task_1_cross_crossing_1</EventName>
                      <Goal>
                        <Type>cross</Type>
                        <Target>crossing_1</Target>
                        <KeyItem>Crosswalk</KeyItem>
                      </Goal>
                      <Instructions>
                        <Text lang="en">Wait for green, then cross</Text>
                      </Instructions>
                      <Feedback>
                        <Success lang="en">Well done!</Success>
                        <Failure lang="en">That did not work. Try again.</Failure>
                      </Feedback>
                      <Target>
                        <Position>
                          <WorldPosition x="12.002" y="4.250" z="0.000" h="-1.5708" p="0" r="0" />
                        </Position>
                        <UserData>
                          <Feature id="crossing_1" u="1" v="0" />
                        </UserData>
                      </Target>
                      <Constraints>
                        <precedence>1</precedence>
                        <evaluation>proximity</evaluation>
                        <MaxSpeed value="3" />
                        <Tolerance value="1.5" />
                        <StartTime value="0" />
                      </Constraints>
                      <FailureCondition>
                        <InitialTimeoutFailureCondition timeout="60" />
                        <BaselineTimeoutFailureCondition timeout="90" />
                        <SignalViolationFailureCondition crossing="crossing_1" signal="signal_1" />
                      </FailureCondition>
                      <Spec origin="helper">
                        <Goal>
                          <F op="eventually" start="0">
                            <F op="in_zone">
                              <Zone kind="disc" x="12.00210405" y="4.25" r="1.5" />
                            </F>
                          </F>
                        </Goal>
                        <Safety>
                          <F op="always" start="0" label="crossed on red">
                            <F op="implies">
                              <F op="and">
                                <F op="in_zone">
                                  <Zone kind="rect" cx="12.00210405" cy="0" h="1.570796327" hl="3.25" hw="1.5" />
                                </F>
                                <F op="prev" init="true">
                                  <F op="not">
                                    <F op="in_zone">
                                      <Zone kind="rect" cx="12.00210405" cy="0" h="1.570796327" hl="3.25" hw="1.5" />
                                    </F>
                                  </F>
                                </F>
                              </F>
                              <F op="signal_is" state="green" signal="signal_1" />
                            </F>
                          </F>
                        </Safety>
                      </Spec>
                    </VRTask>
                  </CustomCommandAction>
                </UserDefinedAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="T1Time" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition value="0.0" rule="greaterOrEqual" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActStart" delay="0.0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition value="0.0" rule="greaterOrEqual" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
        <StopTrigger />
      </Act>
    </Story>
