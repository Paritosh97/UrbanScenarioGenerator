<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="OpenScenario.xsd">
  <FileHeader description="dyn_nav_approaching_car" author="usg" revMajor="1" revMinor="3" date="2026-10-27T21:36:05.602441">
    <Properties>
      <Property name="usg_scenario_type" value="dyn_nav" />
      <Property name="usg_description" value="Cross a road while a car approaches; avoid it." />
    </Properties>
  </FileHeader>
  <CatalogLocations />
  <RoadNetwork>
    <LogicFile filepath="map.xodr" />
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="User">
      <Pedestrian name="User" pedestrianCategory="pedestrian" model3d="user_rig" mass="75.0">
        <BoundingBox>
          <Center x="0.0" y="0.0" z="0.875" />
          <Dimensions width="0.6" length="0.6" height="1.75" />
        </BoundingBox>
        <Properties>
          <Property name="usg_role" value="user" />
        </Properties>
      </Pedestrian>
    </ScenarioObject>
    <ScenarioObject name="Car1">
      <Vehicle name="Car1" vehicleCategory="car" model3d="car_white">
        <BoundingBox>
          <Center x="1.4" y="0.0" z="0.75" />
          <Dimensions width="2.0" length="4.6" height="1.5" />
        </BoundingBox>
        <Performance maxSpeed="50.0" maxDeceleration="10.0" maxAcceleration="8.0" />
        <Axles>
          <FrontAxle maxSteering="0.5" wheelDiameter="0.8" trackWidth="1.68" positionX="2.98" positionZ="0.4" />
          <RearAxle maxSteering="0.0" wheelDiameter="0.8" trackWidth="1.68" positionX="0.0" positionZ="0.4" />
        </Axles>
        <Properties>
          <Property name="usg_role" value="vehicle" />
        </Properties>
      </Vehicle>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="User">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <WorldPosition x="-70.0" y="-5.25" z="0.0" h="1.5708" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time" />
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="0.0" />
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
        <Private entityRef="Car1">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <WorldPosition x="-99.998" y="-1.625" z="0.0" h="0.0" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time" />
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="0.0" />
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="UserTaskStory">
      <Act name="UserTaskAct">
        <ManeuverGroup name="UserTaskGroup" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="User" />
          </Actors>
          <Maneuver name="UserTasks">
            <Event name="task_1_cross_with_traffic" priority="override" maximumExecutionCount="1">
              <Action name="vr_task">
                <UserDefinedAction>
                  <CustomCommandAction type="VR_TASK">
                    <VRTask id="1" name="cross_with_traffic" category="dynamic" required="true">
                      <EventName>task_1_cross_with_traffic</EventName>
                      <Goal>
                        <Type>cross</Type>
                        <Target>crossing_3</Target>
                        <KeyItem>Crosswalk</KeyItem>
                      </Goal>
                      <Instructions>
                        <Text lang="en">Check the traffic, then cross</Text>
                      </Instructions>
                      <Feedback>
                        <Success lang="en">You crossed safely.</Success>
                        <Failure lang="en">The car hit you. Look before you cross.</Failure>
                      </Feedback>
                      <Target>
                        <Position>
                          <WorldPosition x="-70.000" y="4.250" z="0.000" h="-1.5708" p="0" r="0" />
                        </Position>
                        <UserData>
                          <Feature id="crossing_3" u="1" v="0" />
                        </UserData>
                      </Target>
                      <Constraints>
                        <precedence>1</precedence>
                        <evaluation>proximity</evaluation>
                        <MaxSpeed value="3" />
                        <Tolerance value="1.5" />
                        <StartTime value="0" />
                      </Constraints>
                      <FailureCondition>
                        <InitialTimeoutFailureCondition timeout="60" />
                        <BaselineTimeoutFailureCondition timeout="90" />
                        <CollisionFailureCondition>
                          <EntityRef entityRef="Car1" />
                        </CollisionFailureCondition>
                      </FailureCondition>
                      <Spec origin="helper">
                        <Goal>
                          <F op="eventually" start="0">
                            <F op="in_zone">
                              <Zone kind="disc" x="-69.99989524" y="4.25" r="1.5" />
                            </F>
                          </F>
                        </Goal>
                        <Safety>
                          <F op="always" start="0" label="collision with Car1">
                            <F op="dist_ge" d="0.3" entity="Car1" />
                          </F>
                        </Safety>
                      </Spec>
                    </VRTask>
                  </CustomCommandAction>
                </UserDefinedAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="T1Time" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition value="0.0" rule="greaterOrEqual" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActStart" delay="0.0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition value="0.0" rule="greaterOrEqual" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
        <StopTrigger />
      </Act>
    </Story>
    <Story name="MoveStory_Car1">
      <Act name="MoveAct_Car1">
        <ManeuverGroup name="MoveGroup_Car1" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Car1" />
          </Actors>
          <Maneuver name="Move_Car1">
            <Event name="move_Car1" priority="override" maximumExecutionCount="1">
              <Action name="speed">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time" />
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="8.0" />
                      </SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <Action name="route">
                <PrivateAction>
                  <RoutingAction>
                    <FollowTrajectoryAction>
                      <TrajectoryRef>
                        <Trajectory name="route_Car1" closed="false">
                          <Shape>
                            <Polyline>
                              <Vertex time="0.0">
                                <Position>
                                  <WorldPosition x="-99.998" y="-1.625" z="0.0" h="0.0" />
                                </Position>
                              </Vertex>
                              <Vertex time="1.25">
                                <Position>
                                  <WorldPosition x="-89.998" y="-1.625" z="0.0" h="0.0" />
                                </Position>
                              </Vertex>
                              <Vertex time="2.5">
                                <Position>
                                  <WorldPosition x="-79.998" y="-1.625" z="0.0" h="0.0" />
                                </Position>
                              </Vertex>
                              <Vertex time="3.75">
                                <Position>
                                  <WorldPosition x="-69.998" y="-1.625" z="0.0" h="0.0" />
                                </Position>
                              </Vertex>
                              <Vertex time="5.0">
                                <Position>
                                  <WorldPosition x="-59.998" y="-1.625" z="0.0" h="0.0" />
                                </Position>
                              </Vertex>
                              <Vertex time="6.25">
                                <Position>
                                  <WorldPosition x="-49.998" y="-1.625" z="0.0" h="0.0" />
                                </Position>
                              </Vertex>
                              <Vertex time="7.5">
                                <Position>
                                  <WorldPosition x="-39.998" y="-1.625" z="0.0" h="0.0" />
                                </Position>
                              </Vertex>
                            </Polyline>
                          </Shape>
                        </Trajectory>
                      </TrajectoryRef>
                      <TimeReference>
                        <Timing domainAbsoluteRelative="relative" scale="1.0" offset="0.0" />
                      </TimeReference>
                      <TrajectoryFollowingMode followingMode="position" />
                    </FollowTrajectoryAction>
                  </RoutingAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="Car1Start" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                      <StoryboardElementStateCondition storyboardElementType="event" storyboardElementRef="task_1_cross_with_traffic" state="startTransition" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActStart" delay="0.0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition value="0.0" rule="greaterOrEqual" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
        <StopTrigger />
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="StopCondition" delay="0.0" conditionEdge="rising">
          <ByValueCondition>
            <SimulationTimeCondition value="95.0" rule="greaterThan" />
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>