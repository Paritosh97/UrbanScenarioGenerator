        </Properties>
      </Pedestrian>
    </ScenarioObject>
    <ScenarioObject name="signal_234">
      <Pedestrian name="signal_234" pedestrianCategory="pedestrian" model3d="ped_a" mass="75.0">
        <BoundingBox>
          <Center x="0.0" y="0.0" z="0.875" />
          <Dimensions width="0.6" length="0.6" height="1.75" />
        </BoundingBox>
        <Properties>
          <Property name="usg_role" value="walker" />
        </Properties>
      </Pedestrian>
    </ScenarioObject>
