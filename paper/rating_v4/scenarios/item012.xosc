  <Storyboard>
    <Init>
      <Actions>
        <GlobalAction>
          <InfrastructureAction>
            <TrafficSignalAction>
              <TrafficSignalStateAction name="234" state="on;off" />
            </TrafficSignalAction>
          </InfrastructureAction>
        </GlobalAction>
        <Private entityRef="User">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <WorldPosition x="124.05" y="1317.161" z="0.0" h="-0.0787" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time" />
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="0.0" />
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
        <Private entityRef="signal_234">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <WorldPosition x="125.047" y="1317.082" z="0.0" h="-0.0787" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time" />
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="0.0" />
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="UserTaskStory">
      <Act name="UserTaskAct">
        <ManeuverGroup name="UserTaskGroup" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="User" />
          </Actors>
          <Maneuver name="UserTasks">
            <Event name="task_1_wait_then_cross" priority="override" maximumExecutionCount="1">
              <Action name="vr_task">
                <UserDefinedAction>
                  <CustomCommandAction type="VR_TASK">
                    <VRTask id="1" name="wait_then_cross" category="ptp_env" required="true">
                      <EventName>task_1_wait_then_cross</EventName>
                      <Goal>
                        <Type>go</Type>
                        <Target>wait_then_cross</Target>
                        <KeyItem>Location</KeyItem>
                      </Goal>
                      <Instructions>
                        <Text lang="en">Wait for green, then cross.</Text>
                      </Instructions>
                      <Feedback>
                        <Success lang="en">Well done!</Success>
                        <Failure lang="en">That did not work. Try again.</Failure>
                      </Feedback>
                      <Target>
                        <Position>
                          <WorldPosition x="125.047" y="1317.082" z="0.000" h="0.0000" p="0" r="0" />
                        </Position>
                      </Target>
                      <Constraints>
                        <precedence>1</precedence>
                        <evaluation>spec</evaluation>
                        <MaxSpeed value="3" />
                        <Tolerance value="1.5" />
                        <StartTime value="0" />
                      </Constraints>
                      <FailureCondition>
                        <InitialTimeoutFailureCondition timeout="60" />
                        <BaselineTimeoutFailureCondition timeout="90" />
                      </FailureCondition>
                      <Spec origin="spec">
                        <Goal>
                          <F op="until" start="0">
                            <F op="in_zone">
                              <Zone kind="disc" x="125.0472274" y="1317.082497" r="2" />
                            </F>
                            <F op="signal_is" state="green" signal="signal_234" />
                          </F>
                        </Goal>
                        <Safety />
                      </Spec>
                    </VRTask>
                  </CustomCommandAction>
                </UserDefinedAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="T1Time" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition value="0.0" rule="greaterOrEqual" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="task_2_look_then_cross" priority="override" maximumExecutionCount="1">
              <Action name="vr_task">
                <UserDefinedAction>
                  <CustomCommandAction type="VR_TASK">
                    <VRTask id="2" name="look_then_cross" category="ptp_env" required="true">
                      <EventName>task_2_look_then_cross</EventName>
                      <Goal>
                        <Type>go</Type>
                        <Target>look_then_cross</Target>
                        <KeyItem>Location</KeyItem>
                      </Goal>
                      <Instructions>
                        <Text lang="en">Look at the traffic light, then cross.</Text>
                      </Instructions>
                      <Feedback>
                        <Success lang="en">Well done!</Success>
                        <Failure lang="en">That did not work. Try again.</Failure>
                      </Feedback>
                      <Target>
                        <Position>
                          <WorldPosition x="133.521" y="1316.414" z="0.000" h="0.0000" p="0" r="0" />
                        </Position>
                      </Target>
                      <Constraints>
                        <precedence>1</precedence>
                        <evaluation>spec</evaluation>
                        <MaxSpeed value="3" />
                        <Tolerance value="1.5" />
                        <StartTime value="0" />
                      </Constraints>
                      <FailureCondition>
                        <InitialTimeoutFailureCondition timeout="70" />
                        <BaselineTimeoutFailureCondition timeout="100" />
                      </FailureCondition>
                      <Spec origin="spec">
                        <Goal>
                          <F op="and">
                            <F op="eventually" start="0" end="10">
                              <F op="look_at" entity="signal_234" angle="30" />
                            </F>
                            <F op="eventually" start="0">
                              <F op="in_zone">
                                <Zone kind="disc" x="133.5208856" y="1316.413829" r="2" />
                              </F>
                            </F>
                          </F>
                        </Goal>
                        <Safety>
                          <F op="always" label="crossed on red" start="0">
                            <F op="implies">
                              <F op="and">
                                <F op="in_zone">
                                  <Zone kind="rect" cx="129.2840565" cy="1316.748163" h="-0.07874812983" hl="3.25" hw="1.5" />
                                </F>
                                <F op="prev" init="true">
                                  <F op="not">
                                    <F op="in_zone">
                                      <Zone kind="rect" cx="129.2840565" cy="1316.748163" h="-0.07874812983" hl="3.25" hw="1.5" />
                                    </F>
                                  </F>
                                </F>
                              </F>
                              <F op="signal_is" state="green" signal="signal_234" />
                            </F>
                          </F>
                        </Safety>
                      </Spec>
                    </VRTask>
                  </CustomCommandAction>
                </UserDefinedAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="T2Time" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition value="0.0" rule="greaterOrEqual" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActStart" delay="0.0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition value="0.0" rule="greaterOrEqual" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
        <StopTrigger />
      </Act>
    </Story>
