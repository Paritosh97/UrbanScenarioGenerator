  <FileHeader description="cross_with_traffic" author="usg" revMajor="1" revMinor="3" date="2026-11-13T01:58:59.470133">
    <Properties>
      <Property name="usg_scenario_type" value="dyn_nav" />
      <Property name="usg_description" value="Cross a signalised road while a car approaches; obey the signal and avoid the car." />
    </Properties>
  </FileHeader>
  <ParameterDeclarations>
    <ParameterDeclaration name="signal_2" parameterType="string" value="2" />
  </ParameterDeclarations>
  <CatalogLocations />
  <RoadNetwork>
    <LogicFile filepath="map.xodr" />
  </RoadNetwork>
