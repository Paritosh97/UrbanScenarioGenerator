              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="UserTaskStory">
      <Act name="UserTaskAct">
        <ManeuverGroup name="UserTaskGroup" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="User" />
          </Actors>
          <Maneuver name="UserTasks">
            <Event name="task_1_wait_then_cross" priority="override" maximumExecutionCount="1">
              <Action name="vr_task">
                <UserDefinedAction>
                  <CustomCommandAction type="VR_TASK">
                    <VRTask id="1" name="wait_then_cross" category="ptp_env" required="true">
                      <EventName>task_1_wait_then_cross</EventName>
                      <Goal>
                        <Type>go</Type>
                        <Target>wait_then_cross</Target>
                        <KeyItem>Location</KeyItem>
                      </Goal>
                      <Instructions>
                        <Text lang="en">Wait for green, look at the light, then cross.</Text>
                      </Instructions>
                      <Feedback>
                        <Success lang="en">Well done!</Success>
                        <Failure lang="en">That did not work. Try again.</Failure>
                      </Feedback>
                      <Target>
                        <Position>
                          <WorldPosition x="206.656" y="115.463" z="0.000" h="0.0000" p="0" r="0" />
                        </Position>
                      </Target>
                      <Constraints>
                        <precedence>1</precedence>
                        <evaluation>spec</evaluation>
                        <MaxSpeed value="3" />
                        <Tolerance value="1.5" />
                        <StartTime value="0" />
                      </Constraints>
                      <FailureCondition>
                        <InitialTimeoutFailureCondition timeout="70" />
                        <BaselineTimeoutFailureCondition timeout="110" />
                      </FailureCondition>
                      <Spec origin="spec">
                        <Goal>
                          <F op="eventually" start="0">
                            <F op="and">
                              <F op="until" start="0">
                                <F op="in_zone">
                                  <Zone kind="disc" x="219.3962851" y="102.3964702" r="2" />
                                </F>
                                <F op="signal_is" state="green" signal="signal_52" />
                              </F>
                              <F op="eventually" start="0">
                                <F op="and">
                                  <F op="eventually" start="0" end="5">
                                    <F op="look_at" angle="15" px="213.03" py="108.93" />
                                  </F>
                                  <F op="eventually" start="0">
                                    <F op="eventually" start="0">
                                      <F op="in_zone">
                                        <Zone kind="disc" x="206.6556766" y="115.4631987" r="2" />
                                      </F>
                                    </F>
                                  </F>
                                </F>
                              </F>
                            </F>
                          </F>
                        </Goal>
                        <Safety>
                          <F op="always" start="0" label="crossed on red">
                            <F op="implies">
                              <F op="and">
                                <F op="in_zone">
                                  <Zone kind="rect" cx="213.0259809" cy="108.9298344" h="2.343558446" hl="8.125" hw="1.5" />
                                </F>
                                <F op="prev" init="true">
                                  <F op="not">
                                    <F op="in_zone">
                                      <Zone kind="rect" cx="213.0259809" cy="108.9298344" h="2.343558446" hl="8.125" hw="1.5" />
                                    </F>
                                  </F>
                                </F>
                              </F>
                              <F op="signal_is" state="green" signal="signal_52" />
                            </F>
                          </F>
                        </Safety>
                      </Spec>
                    </VRTask>
                  </CustomCommandAction>
                </UserDefinedAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="T1Time" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition value="0.0" rule="greaterOrEqual" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActStart" delay="0.0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition value="0.0" rule="greaterOrEqual" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
        <StopTrigger />
      </Act>
    </Story>
