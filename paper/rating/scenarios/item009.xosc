<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="OpenScenario.xsd">
  <FileHeader description="bench_task" author="usg" revMajor="1" revMinor="3" date="2026-11-13T19:55:02.455507">
    <Properties>
      <Property name="usg_scenario_type" value="custom" />
      <Property name="usg_description" value="Find a bench and walk to it." />
    </Properties>
  </FileHeader>
  <CatalogLocations />
  <RoadNetwork>
    <LogicFile filepath="map.xodr" />
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="bench_270">
      <Pedestrian name="bench_270" pedestrianCategory="pedestrian" model3d="ped_a" mass="75.0">
        <BoundingBox>
          <Center x="0.0" y="0.0" z="0.875" />
          <Dimensions width="0.6" length="0.6" height="1.75" />
        </BoundingBox>
        <Properties>
          <Property name="usg_role" value="walker" />
        </Properties>
      </Pedestrian>
    </ScenarioObject>
    <ScenarioObject name="User">
      <Pedestrian name="User" pedestrianCategory="pedestrian" model3d="user_rig" mass="75.0">
        <BoundingBox>
          <Center x="0.0" y="0.0" z="0.875" />
          <Dimensions width="0.6" length="0.6" height="1.75" />
        </BoundingBox>
        <Properties>
          <Property name="usg_role" value="user" />
        </Properties>
      </Pedestrian>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="bench_270">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <WorldPosition x="234.931" y="157.951" z="0.0" h="2.292" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time" />
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="0.0" />
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
        <Private entityRef="User">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <WorldPosition x="196.523" y="145.584" z="0.0" h="0.3115" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time" />
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="0.0" />
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="UserTaskStory">
      <Act name="UserTaskAct">
        <ManeuverGroup name="UserTaskGroup" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="User" />
          </Actors>
          <Maneuver name="UserTasks">
            <Event name="task_1_find_bench" priority="override" maximumExecutionCount="1">
              <Action name="vr_task">
                <UserDefinedAction>
                  <CustomCommandAction type="VR_TASK">
                    <VRTask id="1" name="find_bench" category="ptp_env" required="true">
                      <EventName>task_1_find_bench</EventName>
                      <Goal>
                        <Type>go</Type>
                        <Target>find_bench</Target>
                        <KeyItem>Location</KeyItem>
                      </Goal>
                      <Instructions>
                        <Text lang="en">Find the bench nearby.</Text>
                      </Instructions>
                      <Feedback>
                        <Success lang="en">Well done!</Success>
                        <Failure lang="en">That did not work. Try again.</Failure>
                      </Feedback>
                      <Target />
                      <Constraints>
                        <precedence>1</precedence>
                        <evaluation>spec</evaluation>
                        <MaxSpeed value="3" />
                        <Tolerance value="1.5" />
                        <StartTime value="0" />
                      </Constraints>
                      <FailureCondition>
                        <InitialTimeoutFailureCondition timeout="15" />
                        <BaselineTimeoutFailureCondition timeout="20" />
                      </FailureCondition>
                      <Spec origin="spec">
                        <Goal>
                          <F op="eventually" start="0" end="10">
                            <F op="look_at" entity="bench_270" angle="45" />
                          </F>
                        </Goal>
                        <Safety />
                      </Spec>
                    </VRTask>
                  </CustomCommandAction>
                </UserDefinedAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="T1Time" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition value="0.0" rule="greaterOrEqual" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="task_2_walk_to_bench" priority="override" maximumExecutionCount="1">
              <Action name="vr_task">
                <UserDefinedAction>
                  <CustomCommandAction type="VR_TASK">
                    <VRTask id="2" name="walk_to_bench" category="ptp_env" required="true">
                      <EventName>task_2_walk_to_bench</EventName>
                      <Goal>
                        <Type>go</Type>
                        <Target>walk_to_bench</Target>
                        <KeyItem>Location</KeyItem>
                      </Goal>
                      <Instructions>
                        <Text lang="en">Walk up to the bench.</Text>
                      </Instructions>
                      <Feedback>
                        <Success lang="en">Well done!</Success>
                        <Failure lang="en">That did not work. Try again.</Failure>
                      </Feedback>
                      <Target>
                        <Position>
                          <WorldPosition x="225.220" y="155.970" z="0.000" h="0.0000" p="0" r="0" />
                        </Position>
                      </Target>
                      <Constraints>
                        <precedence>1</precedence>
                        <evaluation>spec</evaluation>
                        <MaxSpeed value="3" />
                        <Tolerance value="1.5" />
                        <StartTime value="0" />
                      </Constraints>
                      <FailureCondition>
                        <InitialTimeoutFailureCondition timeout="60" />
                        <BaselineTimeoutFailureCondition timeout="90" />
                      </FailureCondition>
                      <Spec origin="spec">
                        <Goal>
                          <F op="eventually" start="0">
                            <F op="in_zone">
                              <Zone kind="disc" x="225.2204629" y="155.9697386" r="3" />
                            </F>
                          </F>
                        </Goal>
                        <Safety />
                      </Spec>
                    </VRTask>
                  </CustomCommandAction>
                </UserDefinedAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="T2Time" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition value="0.0" rule="greaterOrEqual" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActStart" delay="0.0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition value="0.0" rule="greaterOrEqual" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
        <StopTrigger />
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="StopCondition" delay="0.0" conditionEdge="rising">
          <ByValueCondition>
            <SimulationTimeCondition value="95.0" rule="greaterThan" />
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>